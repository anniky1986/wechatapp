{
  "$schema": "https://gitee.com/dotnetchina/Furion/raw/v4/schemas/v4/furion-schema.json",
  "AppSettings": {
    "InjectSpecificationDocument": true,
    "VirtualPath": "/",
    "ExternalAssemblies": [],
    "ExcludeAssemblies": [],
    "CorsAccessorSettings": {
      "WithExposedHeaders": ["Content-Disposition"]
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=AgilityZoey.db",
    "Sqlite": "Data Source=AgilityZoey.db"
  },
  "DatabaseType": "Sqlite",
  "JWTSettings": {
    "ValidateIssuerSigningKey": true,
    "IssuerSigningKey": "AgilityZoey@2026SecretKey!@#$%^",
    "ValidateIssuer": true,
    "ValidIssuer": "Agility.Zoey",
    "ValidateAudience": true,
    "ValidAudience": "Agility.Zoey.Client",
    "ExpiredTime": 7200,
    "RefreshTokenExpiredTime": 604800
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "127.0.0.1:6379,password=,defaultDatabase=0"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}